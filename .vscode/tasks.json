{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Build Product Card App",
			"type": "shell",
			"command": "npm.cmd",
			"args": [
				"--prefix",
				"product-card-app",
				"run",
				"build"
			],
			"isBackground": false,
			"problemMatcher": [
				"$tsc"
			]
		},
		{
			"label": "Test Product Card App",
			"type": "shell",
			"command": "npm.cmd",
			"args": [
				"--prefix",
				"product-card-app",
				"test",
				"--",
				"--watchAll=false"
			],
			"isBackground": false,
			"problemMatcher": [
				"$tsc"
			]
		}
	]
}